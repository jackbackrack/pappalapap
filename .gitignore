# Ignore all hidden files/folders by default (JITX convention)
.*

# Whitelist specific dotfiles/folders
!.gitignore
!.vscode/

.venv/
mechanical/.venv/
.DS_Store
__pycache__/

# JITX: data cache and backups don't need version control; design-info does
# (it holds editor state such as routing that can't be regenerated).
designs/**/cache/
designs/**/temp/
designs/**/design-info/stable.design.backup*
designs/**/design-info/physical-layout.design~
# old seeded sample design (superseded by designs.flex_strip.Pappalapap)
designs/pappalapap.main.Pappalapap/

# part cache does not need to be stored in Git
parts-db/

# Regenerated by `make` (see Makefile)
design-report-*.json
design-report-*.txt
layout/*-input.json
mechanical/out/
jlcpcb/
